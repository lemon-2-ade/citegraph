# Copy to .env and fill in values. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Protects administrative endpoints (ingestion). Generate e.g. with: openssl rand -hex 32
ADMIN_API_TOKEN=

# LLM-backed endpoints (ask, query, insights) cost money. By default they need ADMIN_API_TOKEN
# (open in development when it is unset, disabled in production). Set PUBLIC_AI=true to let
# anyone use them; they are rate limited per client either way.
PUBLIC_AI=false

# --- Databases --------------------------------------------------------------
NEO4J_PASSWORD=change-me-neo4j
POSTGRES_USER=researchgraph
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=researchgraph

# Used when running the backend outside Docker (make dev):
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
DATABASE_URL=postgresql+asyncpg://researchgraph:change-me-postgres@localhost:5432/researchgraph
REDIS_URL=redis://localhost:6379/0

# --- Ingestion --------------------------------------------------------------
# OpenAlex asks API users to identify themselves ("polite pool").
OPENALEX_MAILTO=you@example.com

# --- AI (Phase 7+) ----------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# auto = OpenAI if OPENAI_API_KEY is set, otherwise a local CPU model (BAAI/bge-small-en-v1.5).
# Other values: openai, local, hashing (offline test provider; not semantic).
EMBEDDING_PROVIDER=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
