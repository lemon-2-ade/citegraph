# Copy to .env and fill in values. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# --- Databases --------------------------------------------------------------
NEO4J_PASSWORD=change-me-neo4j
POSTGRES_USER=researchgraph
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=researchgraph

# Used when running the backend outside Docker (make dev):
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
DATABASE_URL=postgresql+asyncpg://researchgraph:change-me-postgres@localhost:5432/researchgraph
REDIS_URL=redis://localhost:6379/0

# --- Ingestion --------------------------------------------------------------
# OpenAlex asks API users to identify themselves ("polite pool").
OPENALEX_MAILTO=you@example.com

# --- AI (Phase 7+) ----------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
